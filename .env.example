# Copy to .env.local and fill in. Never commit real values.
# Test mode and testnets only (security-standards.md section 7).

# Database (Neon Postgres). The test database is used by *.int.test.ts.
DATABASE_URL=postgres://user:password@host/agentvault
DATABASE_URL_TEST=postgres://user:password@host/agentvault_test

# Auth.js with GitHub
AUTH_SECRET=replace-with-32-random-bytes-base64
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# Audit chain head HMAC key: 32 random bytes, base64 (audit-and-approvals AUD-7)
AUDIT_HEAD_KEY=replace-with-32-random-bytes-base64

# Protects /api/cron/* routes (Vercel Cron sends it as a bearer token). At least 32 characters.
CRON_SECRET=replace-with-a-long-random-string
# This deployment's origin; the sandbox's demo vendor pages live here. Defaults to http://localhost:3000.
APP_ORIGIN=http://localhost:3000

# Rails: mock (default) or real. The public sandbox always uses mock.
RAIL_MODE=mock

# Stripe test mode: the key must start with sk_test_
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PROFILE_ID=profile_replace_me

# x402 on Base Sepolia. Step by step in docs/SETUP.md, section 6; check with pnpm env:check.
# X402_PAY_TO is the vendor wallet's address. The agent wallet must be a different wallet.
CDP_API_KEY_ID=replace-me
CDP_API_KEY_SECRET=replace-me
X402_PAY_TO=0x0000000000000000000000000000000000000000
X402_NETWORK=eip155:84532
# The CDP facilitator's minimum, measured on Base Sepolia: 1000 units ($0.001). Also the default when unset.
X402_MIN_UNITS=1000
# Testnet-only key funded from a faucet. Never put a key that holds real funds here.
AGENT_WALLET_PRIVATE_KEY=0xreplace_with_testnet_only_key

# Optional live Gemini agent (demo-agents). Leave empty to hide it.
# Step by step in docs/SETUP.md, section 8; check with pnpm env:check and pnpm gemini:probe.
GEMINI_API_KEY=
# Optional. An exact model ID from pnpm gemini:probe. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=
